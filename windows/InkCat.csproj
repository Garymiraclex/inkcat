<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- .NET Framework 4.8 是 Windows 10（1903 起）和 11 自带的，单个 exe 即可运行 -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>InkCat</RootNamespace>
    <AssemblyTitle>墨团</AssemblyTitle>
    <Product>InkCat</Product>
    <Version>1.2.0</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Web.Extensions" />
    <Resource Include="..\Assets\**\*.png;..\Assets\**\skin.json" Exclude="..\Assets\icon.png;..\Assets\status.png" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="..\art\frames\idle.png;..\art\frames\type_both.png;..\art\frames\sleep.png;..\art\frames\cover_eyes.png" Link="Assets\packs\classic\%(Filename)%(Extension)" />
    <Resource Include="..\docs\素材说明.txt" Link="Assets\guide.txt" />
    <Resource Include="icon.ico" />
    <InternalsVisibleTo Include="InkCat.Test" />
  </ItemGroup>
</Project>
